# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,127.0.0.1,localhost

# Database (MySQL 8.x / InnoDB)
DB_ENGINE=mysql
DB_NAME=ai_time_mng
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Brevo Transactional Email Integration
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=notifications@yourdomain.com
BREVO_SENDER_NAME=AI Time Management
BREVO_DEFAULT_TEMPLATE_ID=
BREVO_WEBHOOK_TOKEN=your_webhook_verification_token

# AI / NLP Provider Integration
AI_PROVIDER=mock
AI_API_KEY=
